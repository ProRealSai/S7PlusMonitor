<UserControl x:Class="S7PlusMonitor.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:S7PlusMonitor.Views">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="PanelsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <views:DisplayPanelView x:Name="MonitorPanel" Grid.Row="0" />
            <views:TrendWorkspaceView x:Name="TrendPanel" Grid.Row="1" Margin="0,8,0,0" />
        </Grid>
        <views:StatusBarView x:Name="StatusBar" Grid.Row="1" Margin="0,8,0,0" />
    </Grid>
</UserControl>
