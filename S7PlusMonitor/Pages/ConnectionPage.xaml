<UserControl x:Class="S7PlusMonitor.Pages.ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:S7PlusMonitor.Views"
             xmlns:entities="clr-namespace:S7PlusMonitor.Core.Data.Entities;assembly=S7PlusMonitor.Core">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔌" Style="{StaticResource EmojiGlyph}" />
                            <TextBlock Text="连接配置" Style="{StaticResource PanelTitleText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ConnectionLockHint}"
                                   Foreground="{StaticResource ActionOrangeBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsConnectionLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Text="档案" Style="{StaticResource FormFieldLabel}" />
                        <ComboBox x:Name="ProfileCombo"
                                  Style="{StaticResource FormComboBox}"
                                  ItemsSource="{Binding Connections}"
                                  SelectedItem="{Binding SelectedConnection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditConnectionProfile}"
                                  IsSynchronizedWithCurrentItem="False"
                                  ToolTip="选择已保存的 PLC 连接档案"
                                  Margin="0,0,0,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type entities:PlcConnectionEntity}">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding NewProfileHint}"
                                   Foreground="{StaticResource ActionOrangeBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsCreatingNewProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="➕ 新建"
                                    Command="{Binding NewConnectionCommand}"
                                    IsEnabled="{Binding CanEditConnectionProfile}"
                                    Style="{StaticResource FilledBlueButton}"
                                    Margin="0,0,6,0"
                                    ToolTip="创建新的连接档案表单" />
                            <Button Grid.Column="1"
                                    Content="🗑️ 删除"
                                    Command="{Binding DeleteConnectionCommand}"
                                    IsEnabled="{Binding CanEditConnectionProfile}"
                                    Style="{StaticResource FilledRedButton}"
                                    Margin="0,0,6,0"
                                    ToolTip="删除当前档案及其监视变量与趋势视图" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        ToolTip="设为默认档案，应用启动时自动选中">
                                <CheckBox IsChecked="{Binding IsDefaultConnection}" VerticalAlignment="Center" />
                                <TextBlock Text="⭐" Style="{StaticResource EmojiGlyph}" FontSize="14" Margin="4,0,4,0" />
                                <TextBlock Text="默认" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="通讯参数" Style="{StaticResource FormSectionTitle}" Margin="0,4,0,8" />
                        <Grid IsEnabled="{Binding CanEditConnectionProfile}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="档案名称" Style="{StaticResource FormFieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="IP / 主机名" Style="{StaticResource FormFieldLabel}" />
                            <TextBox x:Name="ConnectionNameBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="名称"
                                     Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="连接档案的显示名称" Margin="0,0,0,8" />
                            <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="192.168.0.1"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="PLC 的 IP 地址或主机名" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="端口" Style="{StaticResource FormFieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="超时 (秒)" Style="{StaticResource FormFieldLabel}" />
                            <TextBox x:Name="PortBox" Grid.Row="3" Grid.Column="0" Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="102"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="S7 通讯端口，通常为 102" Margin="0,0,0,8" />
                            <TextBox x:Name="TimeoutBox" Grid.Row="3" Grid.Column="2" Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="10"
                                     Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding TimeoutHint}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="用户名" Style="{StaticResource FormFieldLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="密码" Style="{StaticResource FormFieldLabel}" />
                            <TextBox x:Name="UsernameBox" Grid.Row="5" Grid.Column="0" Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="可选"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="PLC 认证用户名（可选）" />
                            <Grid Grid.Row="5" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordSecretBox"
                                             Style="{StaticResource FormPasswordBox}"
                                             materialDesign:HintAssist.Hint="可选"
                                             materialDesign:PasswordBoxAssist.Password="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             ToolTip="PLC 认证密码（可选，保存后加密存储）"
                                             Visibility="{Binding IsPasswordMasked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBox x:Name="PasswordPlainBox"
                                         Style="{StaticResource FormTextBox}"
                                         materialDesign:HintAssist.Hint="可选"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="PLC 认证密码（可选，保存后加密存储）"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Grid.Column="1"
                                        Content="{Binding PasswordVisibilityToggleText}"
                                        Command="{Binding TogglePasswordMaskCommand}"
                                        Style="{StaticResource FilledBlueButton}"
                                        Width="40" Height="40" Margin="4,0,0,0" Padding="0"
                                        ToolTip="{Binding PasswordVisibilityToggleHint}" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="💾 保存"
                                    Command="{Binding SaveConnectionCommand}"
                                    Click="OnCommitFormBindings"
                                    IsEnabled="{Binding CanEditConnectionProfile}"
                                    Style="{StaticResource FilledPurpleButton}"
                                    Margin="0,0,6,0"
                                    ToolTip="保存连接档案、密码、监视周期与 Auto 回退方式" />
                            <Button Grid.Column="1"
                                    Content="🔗 连接"
                                    Command="{Binding ConnectCommand}"
                                    Click="OnCommitFormBindings"
                                    Style="{StaticResource FilledGreenButton}"
                                    Margin="0,0,6,0"
                                    ToolTip="连接到当前 IP/端口，并自动浏览变量" />
                            <Button Grid.Column="2"
                                    Content="🔍 浏览"
                                    Command="{Binding BrowseAndGoCommand}"
                                    Style="{StaticResource FilledBlueButton}"
                                    ToolTip="重新浏览变量并跳转到浏览 Tab" />
                        </Grid>
                        <Button Content="⛔ 断开"
                                Command="{Binding DisconnectCommand}"
                                Style="{StaticResource FilledRedButton}"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                ToolTip="断开与 PLC 的通讯" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:Card Style="{StaticResource AppCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔒" Style="{StaticResource EmojiGlyph}" />
                            <TextBlock Text="安全与监视" Style="{StaticResource PanelTitleText}" />
                        </StackPanel>
                        <Grid IsEnabled="{Binding CanEditConnectionProfile}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="安全模式" Style="{StaticResource FormFieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Auto 回退" Style="{StaticResource FormFieldLabel}"
                                       Visibility="{Binding IsAutoSecurityMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      Style="{StaticResource FormComboBox}"
                                      ItemsSource="{Binding SecurityModes}"
                                      SelectedItem="{Binding SecurityMode}"
                                      ToolTip="{Binding SecurityModeHint}"
                                      Margin="0,0,0,8" />
                            <ComboBox Grid.Row="1" Grid.Column="2"
                                      Style="{StaticResource FormComboBox}"
                                      ItemsSource="{Binding AutoFallbackModeOptions}"
                                      SelectedItem="{Binding SelectedAutoFallbackModeOption}"
                                      DisplayMemberPath="Label"
                                      Visibility="{Binding IsAutoSecurityMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="{Binding AutoFallbackModeHint}"
                                      Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="监视周期 (ms)" Style="{StaticResource FormFieldLabel}" />
                            <TextBox Grid.Row="3" Grid.ColumnSpan="3"
                                     Style="{StaticResource FormTextBox}"
                                     materialDesign:HintAssist.Hint="500"
                                     Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding PollIntervalHint}" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Style="{StaticResource EmojiGlyph}" />
                            <TextBlock Text="历史数据（SQLite）" Style="{StaticResource PanelTitleText}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DatabaseStorageHint}"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12" />
                        <Grid Grid.Row="2" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="数据库文件" Style="{StaticResource CaptionText}" Margin="0,0,12,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseFileSizeText}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="本档案采样" Style="{StaticResource CaptionText}" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionHistoryStorageText}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Button Grid.Row="3"
                                Content="🧹 清理本档案历史采样"
                                Command="{Binding ClearConnectionHistoryCommand}"
                                Style="{StaticResource FilledRedButton}"
                                HorizontalAlignment="Stretch"
                                ToolTip="仅删除当前连接档案的 trend_samples；监视变量与趋势配置保留" />
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <views:StatusBarView x:Name="StatusBar" Grid.Row="1" Margin="0,8,0,0" />
    </Grid>
</UserControl>
