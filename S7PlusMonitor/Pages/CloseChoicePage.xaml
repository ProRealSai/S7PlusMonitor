<UserControl x:Class="S7PlusMonitor.Pages.CloseChoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource PageBackgroundBrush}">
    <materialDesign:Card Style="{StaticResource AppCard}" Margin="16" Padding="16">
        <StackPanel>
            <TextBlock Text="请选择关闭方式："
                       Style="{StaticResource PanelTitleText}"
                       Margin="0,0,0,12" />

            <Button Command="{Binding MinimizeToTrayCommand}"
                    Style="{StaticResource FilledGreenButton}"
                    Height="40"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    ToolTip="隐藏主窗口并在系统托盘继续运行">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📌" Style="{StaticResource EmojiGlyph}" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="最小化到托盘（继续在后台监视）" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding ExitApplicationCommand}"
                    Style="{StaticResource FilledRedButton}"
                    Height="40"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    ToolTip="断开 PLC 并退出应用">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏻" Style="{StaticResource EmojiGlyph}" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="退出程序（断开 PLC 并结束进程）" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource FilledBlueButton}"
                    Height="36"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </materialDesign:Card>
</UserControl>
