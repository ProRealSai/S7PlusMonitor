<UserControl x:Class="S7PlusMonitor.Views.CompactConnectionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" Padding="12,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{Binding ConnectionProfileDisplayName}"
                    Command="{Binding GoToConnectionTabCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    FontWeight="SemiBold"
                    MaxWidth="220"
                    ToolTip="跳转到连接 Tab；已连接时显示锁定档案" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConnectionStateDot}"
                           FontSize="14"
                           Margin="0,0,6,0"
                           Foreground="{Binding IsConnected, Converter={StaticResource ConnectedStatusColorConverter}}" />
                <TextBlock Text="{Binding ConnectionEndpointText}"
                           FontSize="13"
                           Foreground="{Binding IsConnected, Converter={StaticResource ConnectedStatusColorConverter}}" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="⛔ 断开"
                    Command="{Binding DisconnectCommand}"
                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource FilledRedButton}"
                    Width="88"
                    Height="36"
                    ToolTip="断开与 PLC 的通讯" />
        </Grid>
    </Border>
</UserControl>
