<UserControl x:Class="S7PlusMonitor.Views.DisplayPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:S7PlusMonitor.ViewModels">
    <materialDesign:Card Style="{StaticResource AppCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding ToggleMonitorPanelCommand}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Content="{Binding IsMonitorPanelExpanded, Converter={StaticResource BoolToExpandGlyphConverter}}"
                        ToolTip="点击折叠或展开监视表" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📈" Style="{StaticResource EmojiGlyph}" />
                    <TextBlock Text="{Binding PanelTitle}" Style="{StaticResource PanelTitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding ItemCountText}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource CaptionText}"
                               Visibility="{Binding IsMonitorPanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="▶ 监视" Margin="4,0" Command="{Binding StartMonitorCommand}"
                            Visibility="{Binding CanStartMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource FilledBlueButton}" Width="88" Height="36" ToolTip="启动监视表周期读取" />
                    <Button Content="⏹ 停止" Margin="4,0" Command="{Binding StopMonitorCommand}"
                            Visibility="{Binding CanStopMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource FilledBlueButton}" Width="88" Height="36" ToolTip="停止监视表周期读取" />
                    <Button Content="🔄 刷新" Margin="4,0" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding HasActiveSession}"
                            Style="{StaticResource FilledBlueButton}" Width="88" Height="36" ToolTip="重新加载监视表数据" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0"
                  Visibility="{Binding IsMonitorPanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 与原 MAUI 一致：40, 2*, 72, 80, 96, 2*, 140 -->
                <Grid Margin="0,0,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="序号" Style="{StaticResource MonitorHeaderText}" />
                    <TextBlock Grid.Column="1" Text="符号" Style="{StaticResource MonitorHeaderText}" />
                    <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource MonitorHeaderText}" />
                    <TextBlock Grid.Column="3" Text="格式" Style="{StaticResource MonitorHeaderText}" />
                    <TextBlock Grid.Column="4" Text="当前值" Style="{StaticResource MonitorHeaderText}" />
                    <TextBlock Grid.Column="5" Text="强制" Style="{StaticResource MonitorHeaderText}"
                               Visibility="{Binding IsForceColumnVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource MonitorHeaderText}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         HorizontalContentAlignment="Stretch"
                         ToolTip="每行可加入趋势或删除监视变量">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBd" Background="Transparent" Padding="0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="#EEEEEE" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="#F5F5F5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MonitorSheetItemViewModel}">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IndexText}"
                                           Style="{StaticResource MonitorCellText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SymbolDisplay}"
                                           Style="{StaticResource MonitorCellText}"
                                           FontSize="13"
                                           Padding="4,0"
                                           HorizontalAlignment="Left"
                                           Foreground="{Binding IsSymbolMissing, Converter={StaticResource BoolToWarningTextConverter}}"
                                           ToolTip="当前 PLC 中未找到此符号" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DataType}"
                                           Style="{StaticResource MonitorCellText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <ComboBox Grid.Column="3"
                                          Style="{StaticResource MonitorRowComboBox}"
                                          ItemsSource="{Binding AvailableFormats}"
                                          SelectedItem="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="选择显示格式（对齐 TIA 监视表）" />
                                <Border Grid.Column="4"
                                        Background="{StaticResource ValueChipBrush}"
                                        CornerRadius="8"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        Margin="2,0">
                                    <TextBlock Text="{Binding CurrentValue}"
                                               Style="{StaticResource MonitorCellText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </Border>
                                <Grid Grid.Column="5" Margin="0,0,4,0"
                                      Visibility="{Binding IsForceColumnVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Visibility="{Binding IsForceInputVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ForceValueInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MonitorRowEntry}"
                                                 materialDesign:HintAssist.Hint="{Binding ForcePlaceholder}"
                                                 ToolTip="输入强制值，语法与显示格式一致" />
                                        <Button Grid.Column="1"
                                                Content="写入"
                                                Style="{StaticResource RowBlueButton}"
                                                Margin="6,0,0,0"
                                                Command="{Binding ForceWriteCommand}"
                                                ToolTip="将强制值写入 PLC" />
                                    </Grid>
                                    <Button Content="写入/反转"
                                            Command="{Binding ToggleBoolCommand}"
                                            Style="{StaticResource RowBlueButton}"
                                            HorizontalAlignment="Stretch"
                                            Visibility="{Binding IsBoolForceMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="读取当前 BOOL 值并写入相反值" />
                                </Grid>
                                <StackPanel Grid.Column="6"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding TrendActionText}"
                                            Command="{Binding ToggleTrendCommand}"
                                            Background="{Binding IsInTrend, Converter={StaticResource BoolToTrendActionBackgroundConverter}}"
                                            Foreground="White"
                                            Style="{StaticResource RowBlueButton}"
                                            Padding="10,2"
                                            Margin="0,0,6,0"
                                            ToolTip="{Binding TrendActionToolTip}" />
                                    <Button Content="删除"
                                            Command="{Binding RemoveCommand}"
                                            Style="{StaticResource RowRedButton}"
                                            Padding="10,2"
                                            ToolTip="从监视表及趋势图中移除此变量" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Text="{Binding EmptyHint}"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ItemCount, Converter={StaticResource ZeroCountToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
