<UserControl x:Class="S7PlusMonitor.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12,8"
            Background="{StaticResource StatusBarBackgroundBrush}"
            CornerRadius="8"
            MinHeight="36"
            ToolTip="{Binding StatusBarToolTip}"
            ToolTipService.InitialShowDelay="200"
            ToolTipService.ShowDuration="20000"
            ToolTipService.BetweenShowDelay="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressBar Width="16" Height="16" Margin="0,0,8,0"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Foreground="{StaticResource BrandOrangeBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </Grid>
            <TextBlock Grid.Column="1"
                       Text="{Binding PollingStatusText}"
                       Margin="12,0"
                       MinWidth="140"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextAlignment="Right"
                       FontSize="12"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasPollingStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                       ToolTip="{Binding PollingStatusText}" />
            <Border Grid.Column="2"
                    MinWidth="160"
                    Padding="10,4"
                    CornerRadius="12"
                    HorizontalAlignment="Right"
                    Background="{Binding IsConnected, Converter={StaticResource ConnectionChipBackgroundConverter}}"
                    ToolTip="{Binding ConnectionStatusToolTip}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding IsConnected, Converter={StaticResource ConnectedStatusColorConverter}}"
                                 Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Ellipse Stroke="{Binding IsConnected, Converter={StaticResource ConnectedStatusColorConverter}}"
                                 StrokeThickness="2"
                                 Fill="Transparent"
                                 Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Text="{Binding ConnectionEndpointText}"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="{StaticResource AppFontFamily}"
                               VerticalAlignment="Center"
                               Foreground="{Binding IsConnected, Converter={StaticResource ConnectedStatusColorConverter}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
