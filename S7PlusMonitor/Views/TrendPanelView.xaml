<UserControl x:Class="S7PlusMonitor.Views.TrendPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="8" CornerRadius="12" Background="{StaticResource SectionTintBlueBrush}">
            <Grid>
                <lvc:CartesianChart Series="{Binding ActiveView.ChartSeries}"
                                    XAxes="{Binding ActiveView.XAxes}"
                                    YAxes="{Binding ActiveView.YAxes}"
                                    ZoomMode="{Binding ActiveView.ChartZoomMode}"
                                    TooltipPosition="Top"
                                    Visibility="{Binding ActiveView.HasChartSeries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="暂停后可滚轮缩放、拖拽平移" />
                <TextBlock Text="{Binding ActiveView.EmptyHint}"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           Padding="12"
                           Visibility="{Binding ActiveView.HasChartSeries, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ActiveView.StatusHint}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="↺ 重置" Margin="4,0"
                    Command="{Binding ResetChartViewCommand}"
                    Visibility="{Binding IsChartPaused, Converter={StaticResource BooleanToVisibilityConverter}}"
                    IsEnabled="{Binding CanUseTrendTools}"
                    Style="{StaticResource FilledBlueButton}" Width="88" />
            <Button Grid.Column="2" Content="{Binding PauseButtonText}" Margin="4,0"
                    Command="{Binding ToggleChartPauseCommand}"
                    IsEnabled="{Binding CanUseTrendTools}"
                    Style="{StaticResource FilledBlueButton}" Width="88" />
            <Button Grid.Column="3" Content="⚙ 设置" Margin="4,0"
                    Command="{Binding OpenSettingsCommand}"
                    IsEnabled="{Binding HasActiveSession}"
                    Style="{StaticResource FilledBlueButton}" Width="88" />
        </Grid>
    </Grid>
</UserControl>
